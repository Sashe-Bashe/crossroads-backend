{
  "name": "@crossroads/marketplace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "fastify": "^5.12.5", "@fastify/cors": "^11.3.1", "zod": "^4.6.5" },
  "devDependencies": { "@types/node": "^24.10.0", "tsx": "^4.23.15", "typescript": "^5.9.3" }
}
